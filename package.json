{
  "name": "acton",
  "version": "1.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "TON Core",
  "type": "module",
  "workspaces": [
    "packages/explorer-ui",
    "packages/localnet-ui",
    "packages/ui",
    "packages/ui-gallery",
    "packages/transaction-ui",
    "packages/test-ui",
    "packages/ui-e2e"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "dev:ui": "bun --filter @acton/ui-gallery dev",
    "dev:localnet": "bun --filter @acton/localnet-ui dev",
    "dev:test": "bun --filter @acton/test-ui dev",
    "fmt": "bun --filter '*' fmt",
    "fmt:check": "bun --filter '*' fmt:check",
    "lint": "bun --filter '*' lint",
    "lint:fix": "bun --filter '*' lint:fix",
    "test:e2e:ui": "playwright test --config packages/ui-e2e/playwright.config.ts",
    "test:e2e:test-ui": "playwright test --config packages/test-ui/playwright.config.ts",
    "doctor": "CI=1 react-doctor"
  },
  "overrides": {
    "@ton/core": "^0.63.1",
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.10",
    "qs": "^6.15.2",
    "sharp": "^0.35.3",
    "undici": "^7.28.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "1.59.0",
    "react-doctor": "^0.8.1"
  },
  "packageManager": "bun@1.3.5"
}
