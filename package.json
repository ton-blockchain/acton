{
  "name": "acton",
  "version": "1.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "TON Core",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "dev:studio": "bun --filter @acton/studio-ui dev",
    "dev:test": "bun --filter @acton/test-ui dev",
    "dev:ui": "bun --filter @acton/ui-gallery dev",
    "doctor": "CI=1 react-doctor",
    "fmt": "bun --filter '*' fmt",
    "fmt:check": "bun --filter '*' fmt:check",
    "lint": "bun --filter '*' lint",
    "lint:fix": "bun --filter '*' lint:fix",
    "test:e2e:test-ui": "playwright test --config packages/test-ui/playwright.config.ts",
    "test:e2e:ui": "playwright test --config packages/ui-e2e/playwright.config.ts",
    "test:unit": "bun --filter '*' test"
  },
  "overrides": {
    "@ton/core": "^0.63.1",
    "brace-expansion": "5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "^8.5.23",
    "qs": "^6.15.2",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "bun-types": "^1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "1.59.0",
    "react-doctor": "^0.9.3"
  },
  "packageManager": "bun@1.3.14"
}
