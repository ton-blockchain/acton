diff --git a/ton-index-worker/CMakeLists.txt b/ton-index-worker/CMakeLists.txt
--- a/ton-index-worker/CMakeLists.txt
+++ b/ton-index-worker/CMakeLists.txt
@@ -28,3 +28,18 @@
 find_package(Git REQUIRED)
+# Apply separately from the secondary-open patch, which existing builds may
+# already contain. Configure time ensures Ninja sees the changed source before
+# deciding which existing RocksDB objects need recompilation.
+execute_process(
+  COMMAND ${CMAKE_COMMAND}
+    -DGIT_EXECUTABLE=${GIT_EXECUTABLE}
+    -DPATCH_FILE=${CMAKE_CURRENT_SOURCE_DIR}/patches/limit-table-opening-threads.patch
+    -DPATCH_WORKING_DIRECTORY=${CMAKE_CURRENT_SOURCE_DIR}/external/ton/third-party/rocksdb
+    -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/ApplyPatch.cmake
+  RESULT_VARIABLE rocksdb_thread_limit_patch_result
+)
+if(NOT rocksdb_thread_limit_patch_result EQUAL 0)
+  message(FATAL_ERROR "Failed to apply RocksDB table-opening thread limit")
+endif()
+
 set(TON_INDEXER_ROCKSDB_SECONDARY_OPEN_PATCH
     ${CMAKE_CURRENT_SOURCE_DIR}/patches/fix-secondary-open.patch)
