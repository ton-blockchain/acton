[
  {
    "label": "Acton: Run script",
    "command": "acton script \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["acton-script"]
  },
  {
    "label": "Acton: Test $ZED_CUSTOM_acton_test_name",
    "command": "test_name=\"$(printenv ZED_CUSTOM_acton_test_name | sed 's/^`//; s/`$//')\"; acton test \"$(printenv ZED_FILE)\" --filter \"$test_name\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["acton-test"]
  },
  {
    "label": "Acton: Check current file",
    "command": "acton check \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Acton: Format current file",
    "command": "acton fmt \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always"
  }
]
