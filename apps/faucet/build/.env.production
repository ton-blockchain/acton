HOST=0.0.0.0
PORT=3000
# The production port must only be reachable through the trusted reverse proxy.
SERVER_TRUST_PROXY_HEADERS=true

LOG_LEVEL=info
LOG_FORMAT=json

TONCENTER_URL=https://testnet.toncenter.com
TONCENTER_TIMEOUT_SECONDS=10
TONCENTER_CONNECT_TIMEOUT_SECONDS=5
TONCENTER_MAX_RETRIES=3
TONCENTER_RETRY_BASE_DELAY_MS=500

WORKER_MAX_RETRIES=2
WORKER_RETRY_BASE_DELAY_MS=1000

FAUCET_AMOUNT_NANOGRAMS=2GRAM
FAUCET_MESSAGE="Testnet faucet by Acton"

POW_ENABLED=true
POW_DIFFICULTY=24
POW_CHALLENGE_TTL_SECONDS=120
POW_MAX_CHALLENGES=10_000

# Client-side PoW solving limits returned by /challenge.
POW_CLIENT_MAX_SOLVE_TTL_SECONDS=120
POW_CLIENT_MAX_NONCE_ATTEMPTS=1_000_000_000

RATE_LIMIT_DEFAULT_WINDOW_SECONDS=1
RATE_LIMIT_DEFAULT_MAX_REQUESTS=5
RATE_LIMIT_CLAIM_WINDOW_SECONDS=3_600
# Coarse per-IP request cap; successful payout limits remain 2/4/8 per identity.
RATE_LIMIT_CLAIM_MAX_REQUESTS=32

ANTIFRAUD_ENABLED=true

# Wallet balance check: rejects wallets whose balance is above the limit.
ANTIFRAUD_WALLET_BALANCE_ENABLED=true
ANTIFRAUD_WALLET_BALANCE_MAX_NANOGRAMS=20GRAM

# Sent amount sliding window: MAX_NANOGRAMS is the worker send limit, SECONDS is the window length.
ANTIFRAUD_SENT_AMOUNT_WINDOW_ENABLED=true
ANTIFRAUD_SENT_AMOUNT_WINDOW_MAX_NANOGRAMS=10GRAM
ANTIFRAUD_SENT_AMOUNT_WINDOW_SECONDS=60

# Successful claim sliding window: limits successful sends per destination and guest client.
ANTIFRAUD_SUCCESSFUL_CLAIM_WINDOW_ENABLED=true
ANTIFRAUD_SUCCESSFUL_CLAIM_WINDOW_SECONDS=3_600
ANTIFRAUD_SUCCESSFUL_CLAIM_WINDOW_MAX_REQUESTS=2

# Enable after GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are provided by the
# deployment secret store.
GITHUB_AUTH_ENABLED=false
GITHUB_CALLBACK_URL=https://faucet.acton.monster/auth/github/callback
GITHUB_FRONTEND_URL=https://actonscan.com/faucet
# Global authorization starts allowed per state TTL; callbacks do not recycle slots.
GITHUB_OAUTH_MAX_PENDING_STATES=256
GITHUB_VERIFIED_MAX_REQUESTS=4
GITHUB_VERIFIED_MIN_ACCOUNT_AGE_DAYS=90
GITHUB_VERIFIED_MIN_PUBLIC_REPOS=2
GITHUB_VERIFIED_MIN_FOLLOWERS=0
GITHUB_ESTABLISHED_MAX_REQUESTS=8
GITHUB_ESTABLISHED_MIN_ACCOUNT_AGE_DAYS=365
GITHUB_ESTABLISHED_MIN_PUBLIC_REPOS=5
GITHUB_ESTABLISHED_MIN_FOLLOWERS=5
