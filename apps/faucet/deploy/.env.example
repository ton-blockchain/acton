FAUCET_IMAGE_TAG=master

TONCENTER_API_KEY="replace with toncenter api key"
FAUCET_MNEMONIC="replace with 24-word mnemonic"

SERVER_TRUST_PROXY=true
SERVER_TRUST_PROXY_HEADER=X-Real-IP
SERVER_TRUST_PROXY_IPS=192.168.100.0/24

GITHUB_AUTH_ENABLED=true
GITHUB_CLIENT_ID="replace with GitHub App client ID"
GITHUB_CLIENT_SECRET="replace with GitHub App client secret"
GITHUB_CALLBACK_URL=https://faucet.acton.monster/auth/github/callback
GITHUB_FRONTEND_URL=https://actonscan.com/faucet
# Global authorization starts allowed per state TTL; callbacks do not recycle slots.
GITHUB_OAUTH_MAX_PENDING_STATES=256
