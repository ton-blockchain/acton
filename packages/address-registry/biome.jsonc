{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnresolvedImports": "off",
        "useQwikValidLexicalScope": "off"
      },
      "style": {
        "useExportsLast": "off"
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  }
}
