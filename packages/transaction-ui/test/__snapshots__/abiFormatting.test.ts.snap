exports[`ABI rendering of compiled Tolk types renders concrete messages, generic aliases, union tags and wide prefixes 1`] = `
"incoming_messages:
struct GenericMessage<uint32> {
    value: uint32
}

struct GenericMessage<address> {
    value: address
}

incoming_external:
