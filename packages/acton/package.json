{
  "name": "@ton/acton",
  "version": "0.0.0",
  "description": "TypeScript companion library for Acton projects",
  "license": "MIT OR Apache-2.0",
  "author": "TON Core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome check --formatter-enabled=false .",
    "lint:fix": "biome check --formatter-enabled=false --write ."
  },
  "dependencies": {
    "@ton/core": "0.62.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
