{
  "name": "tl-b",
  "displayName": "TL-B",
  "scopeName": "source.tlb",
  "fileTypes": ["tlb"],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#typeDefinitions"
    },
    {
      "include": "#typeParameters"
    },
    {
      "include": "#fields"
    },
    {
      "include": "#hashExpressions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#primitiveTypes"
    },
    {
      "include": "#arrays"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#typeReferences"
    },
    {
      "include": "#parameters"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tlb",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.line.double-slash.tlb"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.tlb",
          "begin": "\\s*/\\*",
          "beginCaptures": {
            "0": {
              "name": "comment.block.begin.tlb punctuation.definition.comment.begin.tlb"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "comment.block.end.tlb punctuation.definition.comment.end.tlb"
            }
          }
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\$[01_]+|#[0-9a-fA-F_]*)",
          "captures": {
            "1": {"name": "entity.name.function.constructor.tlb"},
            "2": {"name": "constant.numeric.constructor-tag.tlb"}
          }
        }
      ]
    },
    "typeParameters": {
      "patterns": [
        {
          "match": "\\{\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)\\s*(Type|#)\\s*\\}",
          "captures": {
            "1": {"name": "variable.parameter.tlb"},
            "2": {"name": "punctuation.separator.tlb"},
            "3": {"name": "support.type.primitive.tlb"}
          }
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": {"name": "variable.other.property.tlb"},
            "2": {"name": "punctuation.separator.tlb"}
          }
        }
      ]
    },
    "hashExpressions": {
      "patterns": [
        {
          "match": "#(?:#|<=|<)?",
          "name": "support.type.primitive.tlb"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "<=|>=|!=|[+*|=<>^~?!-]",
          "name": "keyword.operator.tlb"
        }
      ]
    },
    "primitiveTypes": {
      "patterns": [
        {
          "match": "\\b(u?int\\d*|bits\\d*|Type|Any|Cell|Int|UInt|Bits)\\b",
          "name": "support.type.primitive.tlb"
        }
      ]
    },
    "arrays": {
      "patterns": [
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [{"include": "#expressions"}],
          "name": "meta.array.tlb"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.tlb"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.decimal.tlb"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {"include": "#comment"},
        {"include": "#typeParameters"},
        {"include": "#fields"},
        {"include": "#hashExpressions"},
        {"include": "#operators"},
        {"include": "#primitiveTypes"},
        {"include": "#arrays"},
        {"include": "#numbers"},
        {"include": "#typeReferences"},
        {"include": "#parameters"}
      ]
    },
    "typeDefinitions": {
      "patterns": [
        {
          "match": "(=)\\s*([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.operator.tlb"},
            "2": {"name": "entity.name.type.tlb"}
          }
        }
      ]
    },
    "typeReferences": {
      "patterns": [
        {
          "match": "\\b[A-Z]\\b",
          "name": "variable.parameter.tlb"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.tlb"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "match": "\\b[a-z][a-zA-Z0-9_]*\\b",
          "name": "variable.parameter.tlb"
        }
      ]
    }
  }
}
