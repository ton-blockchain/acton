========================================================================
Match expression with single type arm
========================================================================
fun main() {
    val value: int | bool;

    match (value) {
        int => {
            value;
//!         ^ int
        }
    }
}
------------------------------------------------------------------------
ok

========================================================================
Match expression with single type arm and else
========================================================================
fun main() {
    val value: int | bool;

    match (value) {
        int => {
            value;
//!         ^ int
        },
        else => {
            value;
//!         ^ int | bool
        }
    }
}
------------------------------------------------------------------------
ok

