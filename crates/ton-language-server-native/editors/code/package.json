{
  "name": "vscode-ton",
  "displayName": "TON",
  "version": "1.0.0",
  "description": "Official TON and Acton development support for VS Code",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "TON",
    "The Open Network",
    "Smart contract",
    "Tolk",
    "FunC",
    "Fift",
    "BoC",
    "TL-B"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ton-blockchain/acton.git"
  },
  "license": "MIT",
  "author": "TON Core",
  "publisher": "ton-core",
  "main": "./dist/client.js",
  "scripts": {
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:webview": "vite build --config vite.webview.config.ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "package": "bunx vsce package --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "bun run build",
    "watch": "vite build --watch --config vite.extension.config.ts",
    "watch:webview": "vite build --watch --config vite.webview.config.ts"
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "tasm"
      },
      {
        "language": "tolk"
      }
    ],
    "commands": [
      {
        "command": "tolk.getTypeAtPosition",
        "title": "Get Type At Position",
        "category": "Tolk"
      },
      {
        "command": "ton.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Acton",
        "icon": "$(debug-restart)"
      },
      {
        "command": "ton.showLanguageServerProfile",
        "title": "Show Language Server Profile",
        "category": "Acton",
        "icon": "$(pulse)"
      },
      {
        "command": "ton.openBocFile",
        "title": "Open Disassembled BoC file",
        "category": "TON"
      },
      {
        "command": "ton.saveBocDecompiled",
        "title": "Disassemble BoC to TON Assembly File",
        "category": "TON"
      },
      {
        "command": "ton.acton.debugRetraceTransaction",
        "title": "Debug Retrace Transaction",
        "category": "Acton",
        "icon": "$(debug-start)"
      },
      {
        "command": "ton.acton.debugFailedTest",
        "title": "Debug Failed Test",
        "category": "Acton",
        "icon": "$(debug-start)"
      },
      {
        "command": "ton.acton.initDapp",
        "title": "Initialize dApp",
        "category": "Acton",
        "icon": "$(rocket)"
      },
      {
        "command": "ton.acton.checkForUpdates",
        "title": "Check for Updates",
        "category": "Acton",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ton.acton.rerunFailedTestWithBacktrace",
        "title": "Rerun Failed Test with Full Backtrace",
        "category": "Acton",
        "icon": "$(bug)"
      },
      {
        "command": "ton.acton.openFailedTestUi",
        "title": "Open Failed Test UI",
        "category": "Acton",
        "icon": "$(preview)"
      },
      {
        "command": "ton.acton.openAssemblyPreview",
        "title": "Open Assembly Preview",
        "category": "Acton",
        "icon": "$(symbol-event)"
      },
      {
        "command": "ton.acton.refreshAssemblyPreview",
        "title": "Refresh Assembly Preview",
        "category": "Acton",
        "icon": "$(refresh)"
      },
      {
        "command": "ton.wallets.refresh",
        "title": "Refresh Wallets",
        "category": "TON",
        "icon": "$(refresh)"
      },
      {
        "command": "ton.wallets.import",
        "title": "Import Wallet",
        "category": "TON",
        "icon": "$(repo-pull)"
      },
      {
        "command": "ton.wallets.new",
        "title": "New Wallet",
        "category": "TON",
        "icon": "$(add)"
      }
    ],
    "configuration": [
      {
        "title": "General",
        "properties": {
          "ton.tolk.stdlib.path": {
            "type": "string",
            "default": null,
            "description": "Path to Tolk standard library. If empty, will try to find in node_modules"
          }
        }
      },
      {
        "title": "Editor › Hints",
        "properties": {
          "ton.tolk.hints.disable": {
            "type": "boolean",
            "default": false,
            "description": "Disable all inlay hints"
          },
          "ton.tolk.hints.types": {
            "type": "boolean",
            "default": true,
            "description": "Show type hints for variables and expressions"
          },
          "ton.tolk.hints.parameters": {
            "type": "boolean",
            "default": true,
            "description": "Show parameter name hints in function calls"
          },
          "ton.tolk.hints.showMethodId": {
            "type": "boolean",
            "default": true,
            "description": "Show method ID hints for get methods"
          },
          "ton.tolk.hints.constantValues": {
            "type": "boolean",
            "default": true,
            "description": "Show computed values for constants and enum members"
          },
          "ton.func.hints.disable": {
            "type": "boolean",
            "default": false,
            "description": "Disable all inlay hints for FunC"
          },
          "ton.func.hints.showMethodId": {
            "type": "boolean",
            "default": true,
            "description": "Show method ID hints for functions with method_id"
          },
          "ton.func.hints.implicitConstantType": {
            "type": "boolean",
            "default": true,
            "description": "Show type hints for constants without explicit type"
          },
          "ton.tlb.hints.disable": {
            "type": "boolean",
            "default": false,
            "description": "Disable all inlay hints for TL-B"
          },
          "ton.tlb.hints.showConstructorTag": {
            "type": "boolean",
            "default": true,
            "description": "Show constructor tag hints for TL-B constructors without explicit tags"
          }
        }
      },
      {
        "title": "Editor › Completion",
        "properties": {
          "ton.tolk.completion.typeAware": {
            "type": "boolean",
            "default": true,
            "description": "Sort completion items by relevance to the current context type"
          },
          "ton.tolk.completion.addImports": {
            "type": "boolean",
            "default": true,
            "description": "Automatically add necessary imports for symbols from other files"
          }
        }
      },
      {
        "title": "Editor › Inspections",
        "properties": {
          "ton.func.inspections.disabled": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "unused-parameter",
                "unused-type-parameter",
                "unused-variable",
                "unused-import"
              ]
            },
            "default": [],
            "description": "List of disabled code inspections for FunC. All inspections are enabled by default."
          }
        }
      },
      {
        "title": "Find Usages",
        "properties": {
          "ton.tolk.findUsages.scope": {
            "type": "string",
            "enum": [
              "workspace",
              "everywhere"
            ],
            "enumDescriptions": [
              "Search only in workspace files (default)",
              "Search everywhere including standard library"
            ],
            "default": "workspace",
            "description": "Where to search when using Find Usages"
          }
        }
      },
      {
        "title": "Fift",
        "properties": {
          "ton.fift.hints.showGasConsumption": {
            "type": "boolean",
            "default": true,
            "description": "Show gas consumption hints for Fift instructions"
          },
          "ton.fift.semanticHighlighting.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable/disable semantic highlighting for Fift files"
          }
        }
      },
      {
        "title": "BoC",
        "properties": {
          "ton.boc.openDecompiledOnOpen": {
            "type": "boolean",
            "default": true,
            "description": "Automatically open disassembled Fift assembly when opening BoC files"
          }
        }
      },
      {
        "title": "Acton",
        "properties": {
          "ton.acton.path": {
            "type": "string",
            "default": "acton",
            "description": "Path to the Acton executable used by the language server and Acton tools"
          },
          "ton.languageServer.args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "ls",
              "--stdio"
            ],
            "description": "Arguments used to start the Acton language server. The command must use stdio transport."
          },
          "ton.languageServer.profiling.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Collect language server performance profiles. Requires a server restart."
          },
          "ton.acton.explorer": {
            "type": "string",
            "enum": [
              "tonscan",
              "tonviewer"
            ],
            "default": "tonscan",
            "description": "Explorer used for clickable TON addresses in Acton output"
          },
          "ton.acton.updateChecks.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Check for Acton CLI updates in Acton projects"
          },
          "ton.acton.linter.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Acton linter (runs `acton check` on file changes)"
          },
          "ton.acton.linter.debounce": {
            "type": "number",
            "default": 100,
            "description": "Debounce time in milliseconds for the Acton linter"
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "boc.editor",
        "displayName": "BoC Editor",
        "selector": [
          {
            "filenamePattern": "*.boc"
          }
        ],
        "priority": "default"
      }
    ],
    "debuggers": [
      {
        "type": "acton",
        "label": "Acton Debug"
      },
      {
        "type": "tolk",
        "label": "Tolk Debug"
      }
    ],
    "grammars": [
      {
        "language": "tolk",
        "scopeName": "source.tolk",
        "path": "./dist/syntaxes/tolk.tmLanguage.json"
      },
      {
        "language": "func",
        "scopeName": "source.func",
        "path": "./dist/syntaxes/func.tmLanguage.json"
      },
      {
        "language": "tasm",
        "scopeName": "source.tasm",
        "path": "./dist/syntaxes/tasm.tmLanguage.json"
      },
      {
        "language": "fift",
        "scopeName": "source.fift",
        "path": "./dist/syntaxes/fift.tmLanguage.json"
      },
      {
        "language": "tlb",
        "scopeName": "source.tlb",
        "path": "./dist/syntaxes/tlb.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "tolk",
        "aliases": [
          "Tolk"
        ],
        "extensions": [
          ".tolk"
        ],
        "icon": {
          "light": "./dist/icons/ton-icon.svg",
          "dark": "./dist/icons/ton-icon.svg"
        },
        "configuration": "./dist/languages/tolk-language-configuration.json"
      },
      {
        "id": "func",
        "aliases": [
          "FunC"
        ],
        "extensions": [
          ".fc",
          ".func"
        ],
        "icon": {
          "light": "./dist/icons/ton-icon.svg",
          "dark": "./dist/icons/ton-icon.svg"
        },
        "configuration": "./dist/languages/func-language-configuration.json"
      },
      {
        "id": "tasm",
        "aliases": [
          "TASM",
          "TON Assembly"
        ],
        "extensions": [
          ".tasm"
        ],
        "icon": {
          "light": "./dist/icons/ton-icon.svg",
          "dark": "./dist/icons/ton-icon.svg"
        },
        "configuration": "./dist/languages/tasm-language-configuration.json"
      },
      {
        "id": "fift",
        "aliases": [
          "Fift"
        ],
        "extensions": [
          ".fif",
          ".fift"
        ],
        "icon": {
          "light": "./dist/icons/ton-icon.svg",
          "dark": "./dist/icons/ton-icon.svg"
        },
        "configuration": "./dist/languages/fift-language-configuration.json"
      },
      {
        "id": "boc",
        "extensions": [
          ".boc"
        ],
        "aliases": [
          "TON BoC"
        ],
        "icon": {
          "light": "./dist/icons/icon-boc-dark.svg",
          "dark": "./dist/icons/icon-boc-dark.svg"
        }
      },
      {
        "id": "tlb",
        "aliases": [
          "TL-B"
        ],
        "extensions": [
          ".tlb"
        ],
        "icon": {
          "light": "./dist/icons/icon-tlb-dark.svg",
          "dark": "./dist/icons/icon-tlb-dark.svg"
        },
        "configuration": "./dist/languages/tlb-language-configuration.json"
      },
      {
        "id": "toml",
        "aliases": [
          "TOML"
        ],
        "filenames": [
          "Acton.toml"
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .boc",
          "command": "ton.openBocFile",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == '.boc'",
          "command": "ton.saveBocDecompiled",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == '.tolk'",
          "command": "ton.acton.openAssemblyPreview",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'Acton.toml'",
          "command": "ton.acton.initDapp",
          "group": "acton@1"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == tolk",
          "command": "tolk.getTypeAtPosition",
          "group": "z_commands@999"
        },
        {
          "when": "resourceLangId == tolk",
          "command": "ton.acton.openAssemblyPreview",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceScheme == acton-assembly-preview",
          "command": "ton.acton.refreshAssemblyPreview",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ton.wallets.refresh",
          "when": "view == tonWallets",
          "group": "navigation"
        },
        {
          "command": "ton.wallets.import",
          "when": "view == tonWallets",
          "group": "navigation"
        },
        {
          "command": "ton.wallets.new",
          "when": "view == tonWallets",
          "group": "navigation"
        }
      ],
      "testing/message/content": [
        {
          "command": "ton.acton.debugFailedTest",
          "when": "testMessage == actonFailure",
          "group": "navigation@1"
        },
        {
          "command": "ton.acton.rerunFailedTestWithBacktrace",
          "when": "testMessage == actonFailure",
          "group": "navigation@2"
        },
        {
          "command": "ton.acton.openFailedTestUi",
          "when": "testMessage == actonFailure",
          "group": "navigation@3"
        }
      ],
      "testing/message/context": [
        {
          "command": "ton.acton.debugFailedTest",
          "when": "testMessage == actonFailure",
          "group": "navigation@1"
        },
        {
          "command": "ton.acton.rerunFailedTestWithBacktrace",
          "when": "testMessage == actonFailure",
          "group": "navigation@2"
        },
        {
          "command": "ton.acton.openFailedTestUi",
          "when": "testMessage == actonFailure",
          "group": "navigation@3"
        }
      ]
    },
    "snippets": [],
    "views": {
      "tonWalletsContainer": [
        {
          "id": "tonWallets",
          "type": "webview",
          "name": "Wallets",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tonWalletsContainer",
          "title": "TON Wallets",
          "icon": "$(account)"
        }
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:Acton.toml",
    "onCommand:ton.acton.debugRetraceTransaction",
    "onCommand:ton.acton.initDapp",
    "onCommand:ton.acton.checkForUpdates",
    "onCommand:ton.acton.openAssemblyPreview",
    "onCommand:ton.acton.refreshAssemblyPreview",
    "onLanguage:tolk",
    "onLanguage:func",
    "onLanguage:tasm",
    "onLanguage:fift",
    "onLanguage:boc",
    "onLanguage:tlb",
    "onLanguage:toml"
  ],
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "smol-toml": "^1.6.1",
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.88.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "icon": "dist/logo.png"
}
