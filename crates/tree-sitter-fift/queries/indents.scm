; Editor indentation rules for Fift assembly blocks.

(program "END>c" @end) @indent
(proc_definition "}>" @end) @indent
(proc_inline_definition "}>" @end) @indent
(proc_ref_definition "}>" @end) @indent
(method_definition "}>" @end) @indent
(if_statement "}>" @end) @indent
(ifjmp_statement "}>" @end) @indent
(while_statement "}>" @end) @indent
(repeat_statement "}>" @end) @indent
(until_statement "}>" @end) @indent
(instruction_block "}>" @end) @indent
